# MoneyPrinterTurboPro Environment Configuration
# Copy this file to .env and fill in your actual values

# Application Settings
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=postgresql://mptp_user:mptp_password@localhost:5432/mptp_db
POSTGRES_DB=mptp_db
POSTGRES_USER=mptp_user
POSTGRES_PASSWORD=mptp_password

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=mptp_redis_password

# API Keys (Required for full functionality)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
AZURE_SPEECH_KEY=your_azure_speech_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# AWS Configuration (Optional - for S3 storage)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=your_s3_bucket_name
AWS_REGION=us-east-1

# Azure Configuration (Optional - for Azure Blob storage)
AZURE_STORAGE_ACCOUNT=your_azure_storage_account
AZURE_STORAGE_KEY=your_azure_storage_key
AZURE_CONTAINER_NAME=your_container_name

# Google Cloud Configuration (Optional - for GCS storage)
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_CLOUD_CREDENTIALS=path_to_your_service_account_key.json

# Security Settings
SECRET_KEY=your_secret_key_here_make_it_long_and_random
JWT_SECRET_KEY=your_jwt_secret_key_here_make_it_long_and_random
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Email Configuration (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=your_email@gmail.com

# Monitoring Configuration
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true
METRICS_PORT=9090

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_WORKER_CONCURRENCY=4

# File Upload Limits
MAX_FILE_SIZE=100MB
ALLOWED_VIDEO_FORMATS=mp4,avi,mov,mkv
ALLOWED_AUDIO_FORMATS=mp3,wav,flac,aac

# Video Processing
DEFAULT_VIDEO_QUALITY=1080p
DEFAULT_VIDEO_FPS=30
MAX_VIDEO_DURATION=300
ENABLE_GPU_ACCELERATION=false

# Rate Limiting
API_RATE_LIMIT=100
WEB_RATE_LIMIT=1000
RATE_LIMIT_WINDOW=3600

# Cache Configuration
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# Logging Configuration
LOG_FILE_PATH=./logs
LOG_FILE_MAX_SIZE=100MB
LOG_FILE_BACKUP_COUNT=5
